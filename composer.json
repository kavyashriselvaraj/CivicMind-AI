{
    "name": "civicmind/x",
    "description": "CivicMind X - AI Digital Life Operating System",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3.0",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "CivicMind\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CivicMind\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8000 -t public public/router.php",
        "test": "php tests/run_tests.php"
    }
}
